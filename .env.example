# --- Base de données Postgres (Neon) -----------------------------------------
# Chaîne de connexion complète, utilisée par les routes /api/devis et
# /api/partenaire pour enregistrer chaque demande dans la table `leads`.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Envoi des e-mails (Resend) ----------------------------------------------
# Clé API Resend. Le domaine d'expédition doit être vérifié dans Resend.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Adresse qui reçoit les demandes de devis et les demandes partenaires.
LEADS_EMAIL="contact@lavagetapis.fr"

# Expéditeur affiché. Le domaine doit être vérifié dans Resend.
LEADS_FROM="lavagetapis.fr <devis@lavagetapis.fr>"

# --- Suivi des conversions ----------------------------------------------------
# Conteneur Google Tag Manager (GTM-XXXXXXX). Laisser vide pour désactiver
# le chargement du script ; les événements dataLayer sont poussés dans tous les cas.
NEXT_PUBLIC_GTM_ID=""

# --- Anti-spam -----------------------------------------------------------------
# Sel utilisé pour hacher l'IP avant stockage (rate limit 5 envois/heure/IP).
IP_HASH_SALT="changez-moi"
